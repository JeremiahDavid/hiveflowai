{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiveflow.dev/schemas/dna/industry-template.json",
  "title": "Industry Data Model Template",
  "description": "Source-agnostic canonical entities, fields, joins, and KPI catalog for one industry. No source binding — a client mapping (hiveflow.dna.industry_mapping) binds a client's actual silver data onto this template.",
  "type": "object",
  "required": ["pack_id", "version", "status", "entities", "kpis"],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable industry template id (e.g. dental, manufacturing)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "validated", "production"]
    },
    "description": { "type": "string" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    },
    "joins": {
      "type": "array",
      "items": { "$ref": "#/$defs/join" }
    },
    "calendar": { "$ref": "#/$defs/calendar" },
    "kpis": {
      "type": "array",
      "items": { "$ref": "#/$defs/kpi" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "display_name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "date", "datetime", "currency"]
        },
        "required": { "type": "boolean", "default": false },
        "description": { "type": "string" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "grain", "primary_key", "fields"],
      "properties": {
        "id": { "type": "string" },
        "display_name": { "type": "string" },
        "grain": { "type": "string" },
        "primary_key": {
          "type": "string",
          "description": "field id (on this entity) that uniquely identifies a row"
        },
        "description": { "type": "string" },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether every client implementation in this industry needs this entity mapped."
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "join": {
      "type": "object",
      "required": ["id", "left_entity", "right_entity", "left_key", "right_key", "cardinality"],
      "properties": {
        "id": { "type": "string" },
        "left_entity": { "type": "string" },
        "right_entity": { "type": "string" },
        "left_key": { "type": "string" },
        "right_key": { "type": "string" },
        "cardinality": {
          "type": "string",
          "enum": ["many_to_one", "one_to_one", "many_to_many"]
        },
        "description": { "type": "string" }
      }
    },
    "calendar": {
      "type": "object",
      "required": ["id", "type", "date_field", "period_grain"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["calendar_year", "fiscal_year"] },
        "date_field": {
          "type": "string",
          "description": "entity_id.field_id reference used for period attribution"
        },
        "fiscal_year_start_month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "period_grain": { "type": "string", "enum": ["month", "quarter"] },
        "description": { "type": "string" }
      }
    },
    "kpi": {
      "type": "object",
      "required": ["id", "name", "entity_id", "formula_type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "entity_id": {
          "type": "string",
          "description": "Canonical entity this KPI aggregates over (the row source for filter/group_by/value_field)."
        },
        "formula_type": {
          "type": "string",
          "enum": ["sum", "count", "count_distinct", "avg", "ratio", "period_compare"]
        },
        "value_field": {
          "type": "string",
          "description": "field id on entity_id (required for sum/count_distinct/avg)"
        },
        "filter_field": { "type": "string" },
        "filter_value": {},
        "group_by": {
          "type": "array",
          "items": { "type": "string" },
          "description": "field ids on entity_id forming the dimensional grain"
        },
        "numerator_kpi": {
          "type": "string",
          "description": "sibling kpi id (required for formula_type=ratio)"
        },
        "denominator_kpi": {
          "type": "string",
          "description": "sibling kpi id (required for formula_type=ratio)"
        },
        "base_kpi": {
          "type": "string",
          "description": "sibling kpi id (required for formula_type=period_compare)"
        },
        "compare": { "type": "string" },
        "auto_materializable": {
          "type": "boolean",
          "default": true,
          "description": "false for KPIs that need a cross-entity join, bucketing, or other logic beyond this formula vocabulary — catalog reference only, author via KPI Generator."
        },
        "format": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "decimal_places": { "type": "integer" },
            "scale": { "type": "string" }
          }
        },
        "doc_citation": { "type": "string" }
      }
    }
  }
}
